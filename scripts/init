#!/bin/bash
# Turn this template into a project. Run once, right after cloning.
# Usage: scripts/init --name <name> [--app <app>] [--nested]
#   --app     name the first app apps/<app> (@repo/<app>, dev:<app>) instead of apps/web.
#   --nested  the template lives in a subfolder of a larger repo (<product>/web/):
#             no git init; CI moves to the parent repo; lefthook runs from the parent root.
# It also removes the template's community files and the "Starting a project" section of AGENTS.md.
set -euo pipefail

die() { echo "init: $*" >&2; exit 1; }
usage() { echo "usage: scripts/init --name <name> [--app <app>] [--nested]" >&2; exit 1; }

name=""
app="web"
nested=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name) [ $# -ge 2 ] || usage; name="$2"; shift 2 ;;
    --app) [ $# -ge 2 ] || usage; app="$2"; shift 2 ;;
    --nested) nested=1; shift ;;
    *) usage ;;
  esac
done
[ -n "$name" ] || usage
echo "$name" | grep -Eq '^[a-z][a-z0-9-]*$' || die "name must be lowercase letters, digits and hyphens, starting with a letter"
echo "$app" | grep -Eq '^[a-z][a-z0-9-]*$' || die "app must be lowercase letters, digits and hyphens, starting with a letter"

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
[ -f scripts/init ] || die "already initialised"
dir="$(basename "$root")"

if [ "$app" != web ]; then
  [ -d apps/web ] || die "apps/web not found"
  [ ! -e "apps/$app" ] || die "apps/$app already exists"
  mv apps/web "apps/$app"
fi

NAME="$name" APP="$app" node --input-type=module - <<'JS'
import { readFileSync, writeFileSync, readdirSync } from "node:fs";

const { NAME: name, APP: app } = process.env;
const writeJson = (file, data) => writeFileSync(file, `${JSON.stringify(data, null, 2)}\n`);

const pkg = JSON.parse(readFileSync("package.json", "utf8"));
pkg.name = name;
pkg.description = name;
delete pkg.license;
writeJson("package.json", pkg);

for (const file of readdirSync(`apps/${app}/messages`)) {
  const path = `apps/${app}/messages/${file}`;
  const messages = JSON.parse(readFileSync(path, "utf8"));
  messages.Metadata.title = name;
  messages.Metadata.description = name;
  messages.Shell.title = name;
  writeJson(path, messages);
}

// Every other place that spells the first app: the package, its scripts, the workspace lock, the docs.
if (app !== "web") {
  const rewrite = (file, edit) => writeFileSync(file, edit(readFileSync(file, "utf8")));
  const appPkg = JSON.parse(readFileSync(`apps/${app}/package.json`, "utf8"));
  appPkg.name = `@repo/${app}`;
  writeJson(`apps/${app}/package.json`, appPkg);

  const root = JSON.parse(readFileSync("package.json", "utf8"));
  root.scripts = Object.fromEntries(
    Object.entries(root.scripts).map(([key, value]) => [
      key === "dev:web" ? `dev:${app}` : key,
      value.replace("@repo/web", `@repo/${app}`),
    ]),
  );
  writeJson("package.json", root);

  for (const file of readdirSync(`apps/${app}/messages`)) {
    rewrite(`apps/${app}/messages/${file}`, (text) => text.replaceAll("apps/web/", `apps/${app}/`));
  }
  rewrite("pnpm-lock.yaml", (text) => text.replace(/^ {2}apps\/web:$/m, `  apps/${app}:`));
  rewrite("AGENTS.md", (text) =>
    text.replaceAll("apps/web/", `apps/${app}/`).replace("pnpm dev:web", `pnpm dev:${app}`),
  );
}
JS

# The apps/<app>/ column of the structure block lines up with the packages below it.
app_dir="$(printf '%-16s ' "apps/$app/")"

cat > README.md <<README
# $name

## Commands

- \`pnpm install\` installs dependencies.
- \`pnpm dev\` runs every app ($app: http://localhost:3000).
- \`pnpm check\` is the gate: format, lint, typecheck, locales, unit tests, build.
- \`pnpm e2e\` runs Playwright end-to-end tests with an axe scan.
- \`pnpm update-check\` reports outdated dependencies, Node and pnpm.

## Structure

\`\`\`
${app_dir}Next.js app (routes in src/app, features in src/features)
packages/ui/     Design system: atoms, molecules, organisms, templates, theme
packages/shared/ Result type, http client, env, i18n config
packages/config/ tsconfig, eslint, prettier and vitest presets
scripts/         add-app, update-check, check-locales
\`\`\`

Read AGENTS.md for the rules the linter enforces.
README

# AGENTS.md lists this script and explains how to start a project; neither applies afterwards.
sed -i.bak 's#^\(scripts/ *\)init, #\1#' AGENTS.md && rm -f AGENTS.md.bak
awk '/^## Starting a project$/ { exit } /^$/ { blank++; next } { while (blank > 0) { print ""; blank-- } print }' AGENTS.md > AGENTS.md.new
mv AGENTS.md.new AGENTS.md

rm -f LICENSE scripts/init
# Community files describe the template, not the new project.
rm -rf CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md PRINCIPLES.md .github/ISSUE_TEMPLATE .github/PULL_REQUEST_TEMPLATE.md

if [ "$nested" -eq 1 ]; then
  rm -rf .git
  parent=../.github/workflows
  mkdir -p "$parent"
  for file in .github/workflows/*.yml; do
    [ -e "$file" ] || continue
    base="$(basename "$file")"
    target="$parent/$dir-$base"
    awk -v dir="$dir" -v wf=".github/workflows/$dir-$base" '
      function paths() {
        print "    paths:"
        print "      - \"" dir "/**\""
        print "      - \"" wf "\""
      }
      /^name: / { print "name: " dir " " substr($0, 7); next }
      /^    branches: \[main, develop\]$/ { print; paths(); next }
      /^  group: deploy-/ { sub(/deploy-/, "deploy-" dir "-"); print; next }
      /^    timeout-minutes:/ {
        print
        print "    defaults:"
        print "      run:"
        print "        working-directory: " dir
        next
      }
      /^      - uses: \.\/\.github\/actions\// { sub(/\.\/\.github\/actions\//, "./.github/actions/" dir "-"); print; next }
      /^          context: \.$/ { print "          context: " dir; next }
      { print }
    ' "$file" > "$target"
  done
  # Composite actions move too, prefixed so they do not collide with other parts' actions.
  if [ -d .github/actions ]; then
    mkdir -p ../.github/actions
    for action in .github/actions/*/; do
      [ -d "$action" ] || continue
      cp -R "$action" "../.github/actions/$dir-$(basename "$action")"
    done
  fi
  rm -rf .github
  # Run every hook command from the parent repo root, inside this folder; prefix the
  # command names so they do not collide with other parts' hooks in the root lefthook.yml.
  awk -v dir="$dir" '
    /^    [a-z-]+:$/ { sub(/^    /, "    " dir "-"); print; print "      root: \"" dir "/\""; next }
    { print }
  ' lefthook.yml > lefthook.yml.tmp
  mv lefthook.yml.tmp lefthook.yml
  echo "Initialised $name (nested in $dir/). CI moved to ../.github/workflows/$dir-*.yml."
  echo "Add a lefthook.yml at the product root that extends $dir/lefthook.yml."
else
  rm -rf .git
  git init -q -b main
  echo "Initialised $name (new git repository on main)."
fi
echo "Next: pnpm install"
